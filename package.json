{
  "name": "omnibridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "depcruise": "depcruise apps packages mocks --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "build": "pnpm -r run build",
    "contract:gen": "node --conditions=@omnibridge/source apps/web/src/gen-contract.ts",
    "contract:check": "node --conditions=@omnibridge/source apps/web/src/gen-contract.ts --check",
    "seed": "node --conditions=@omnibridge/source apps/web/src/seed-dev.ts",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@omnibridge/testkit": "workspace:*",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "squawk-cli": "2.70.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
