{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/seed",
    "packages/governors/*/src",
    "packages/providers/*/src",
    "mocks/*/src",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  // apps/ui is a browser app (DOM, JSX, Vite types); it is typechecked by its own tsconfig in its
  // build step (pnpm -r build), so server code here never sees DOM globals.
  "exclude": ["**/dist/**", "**/node_modules/**", "apps/ui/**"]
}
