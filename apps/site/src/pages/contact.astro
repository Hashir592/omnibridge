---
// Contact (PRD §10.2). The contact form arrives with the app in Release 1 (Hashir, 15 Nov 2026):
// until then the page lists the public addresses and the registered office.
import Base from '../layouts/Base.astro';
import { CONTACT, readSettings } from '../settings.ts';

const s = readSettings(process.env);
const addresses = [
  { label: 'Support and access requests', email: CONTACT.support },
  { label: 'Privacy and data requests', email: CONTACT.privacy },
  { label: 'Security issues', email: CONTACT.security },
];
---

<Base
  title="Contact"
  description="Contact OmniBridge: support, privacy and security email addresses and our registered office."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="lead">Email the address that fits your question.</p>
    </header>
    <div class="section-tail">
      <dl class="pairs">
        {
          addresses.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>
                <a href={`mailto:${item.email}`}>{item.email}</a>
              </dd>
            </div>
          ))
        }
        <div>
          <dt>Registered office</dt>
          <dd>
            {s.operatorLegalName}<br />{s.operatorRegisteredAddress}<br />Company number {
              s.operatorCompanyNumber
            }
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Base>
