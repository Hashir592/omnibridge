---
import Base from '../layouts/Base.astro';

const blocks = [
  {
    name: 'Stock and catalogue',
    text: 'One stock figure per product, shared by Amazon and eBay. Sales on one channel lower the stock everywhere, with low-stock alerts, bundles and a full change history.',
  },
  {
    name: 'Orders',
    text: 'Orders from every channel in one list, with dispatch deadlines, filters, bulk actions and a status history for each order.',
  },
  {
    name: 'Shipping',
    text: 'Buy Evri and DPD labels in bulk, print them on a shipping desk built for tablets, and send tracking back to Amazon and eBay automatically.',
  },
  {
    name: 'Customer service',
    text: 'eBay messages and feedback, Amazon buyer messages and seller feedback, and Amazon review requests sent at the right time.',
  },
  {
    name: 'Account health',
    text: 'The health of each Amazon and eBay account on one screen, with alerts before a metric goes out of range.',
  },
  {
    name: 'Advertising',
    text: 'Amazon Ads spend, sales and ACoS by campaign and by product, next to the profit those sales made.',
  },
  {
    name: 'Sales and profit',
    text: 'Profit per order and per product after marketplace fees, shipping, advertising and cost of goods.',
  },
  {
    name: 'Finance and VAT figures',
    text: 'A VAT ledger built from your orders and expenses, with the figures for your VAT return. Money is held to the penny.',
  },
  {
    name: 'Forecasting, reminders and notes',
    text: 'Stock forecasts from your sales history, reminders for the team, and notes kept with the right order or product.',
  },
  {
    name: 'Users and companies',
    text: 'Named users only, each with two-step sign-in. Choose which tabs and which of your companies each person can see. Every change is in the audit log.',
  },
];

// Grouped by what a seller does with them; the module text above is unchanged.
const groups = [
  { name: 'Selling', modules: ['Stock and catalogue', 'Orders', 'Shipping'] },
  { name: 'Customers and marketplaces', modules: ['Customer service', 'Account health', 'Advertising'] },
  { name: 'Money', modules: ['Sales and profit', 'Finance and VAT figures'] },
  { name: 'Team', modules: ['Forecasting, reminders and notes', 'Users and companies'] },
].map((group) => ({
  ...group,
  blocks: group.modules.map((name) => blocks.find((block) => block.name === name)!),
}));
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base
  title="Features"
  description="What OmniBridge does: stock, orders, shipping labels, customer service, account health, Amazon Ads, profit and VAT figures."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Features</h1>
      <p class="lead">Everything a UK seller on Amazon and eBay needs, in one place.</p>
    </header>
    <div class="section-tail">
      {
        groups.map((group) => (
          <section class="feature-group" aria-labelledby={slug(group.name)}>
            <h2 id={slug(group.name)}>{group.name}</h2>
            <ul class="module-list">
              {group.blocks.map((block) => (
                <li id={slug(block.name)}>
                  <h3>{block.name}</h3>
                  <p>{block.text}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <p class="muted feature-foot">
        How each marketplace is connected: <a href="/amazon">Amazon</a> and <a href="/ebay">eBay</a>.
        How data is protected: <a href="/security">security and data</a>.
      </p>
    </div>
  </div>
</Base>
