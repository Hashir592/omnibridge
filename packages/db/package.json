{
  "name": "@omnibridge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "@omnibridge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "@omnibridge/source": "./src/platform.ts",
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./seed": {
      "@omnibridge/source": "./src/seed/launch.ts",
      "types": "./dist/seed/launch.d.ts",
      "default": "./dist/seed/launch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@omnibridge/core": "workspace:*",
    "@omnibridge/crypto": "workspace:*",
    "@omnibridge/files": "workspace:*",
    "@omnibridge/governor-amazon": "workspace:*",
    "@omnibridge/governor-ebay": "workspace:*",
    "@omnibridge/logger": "workspace:*",
    "@omnibridge/queue": "workspace:*",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@omnibridge/testkit": "workspace:*"
  }
}
